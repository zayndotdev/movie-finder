# CineMatch Environment Variables Configuration

# Server Port
PORT=5000

# The Movie Database (TMDB) API Key (Free from https://www.themoviedb.org/settings/api)
# Note: CineMatch includes high-fidelity curated fallback data if this key is not set!
TMDB_API_KEY=

# Google Gemini API Key (Free from https://aistudio.google.com/app/apikey)
# Powers natural language mood and conversational movie/TV discovery
GEMINI_API_KEY=

# Groq API Key (Free from https://console.groq.com/keys)
# Ultra-fast fallback inference for Llama 3.1 8B Instant
GROQ_API_KEY=

# Client API Base URL
VITE_API_BASE_URL=http://localhost:5000/api
